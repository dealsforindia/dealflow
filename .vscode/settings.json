{
    "git.enabled": false,
    "git.autorefresh": false,
    "git.autofetch": false,
    "typescript.tsserver.maxTsServerMemory": 4096,
    "typescript.disableAutomaticTypeAcquisition": true,
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/node_modules/**": true,
        "**/_archive/**": true,
        "**/scratch/**": true,
        "**/screenpipe_src/**": true,
        "**/graphify-out/**": true,
        "**/dist/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/_archive": true,
        "**/scratch": true,
        "**/screenpipe_src": true,
        "**/graphify-out": true,
        "**/dist": true,
        "**/.venv": true
    },
    "git.enableSmartCommit": false,
    "git.enableStatusBarSync": false
}